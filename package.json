{
  "name": "purposesource-registry-v0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase-D curated registry and the index-build-lite job that emits the registry half of the v0 public artifact plane.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate-registry.mjs",
    "build": "node scripts/index-build-lite.mjs",
    "build:demo": "node scripts/index-build-lite.mjs --include-examples --out dist-demo --stats-config tests/fixtures/publish-stats.json",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "check:artifacts:demo": "node scripts/check-artifacts.mjs --dir dist-demo --expect-examples",
    "check:schema": "node scripts/check-artifacts-schema.mjs",
    "check:schema:demo": "node scripts/check-artifacts-schema.mjs --dir dist-demo",
    "check:copy": "node scripts/check-copy.mjs",
    "check:no-records": "node scripts/check-no-records.mjs",
    "test:unit": "node --test \"tests/*.test.mjs\"",
    "test": "npm run check:no-records && npm run validate && npm run check:copy && npm run build && npm run check:artifacts && npm run check:schema && npm run build:demo && npm run check:artifacts:demo && npm run check:schema:demo && npm run test:unit"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "js-yaml": "4.3.2"
  }
}
