root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Emitted artifacts and committed data are 2-space JSON with a trailing newline; the
# generators produce exactly that, so an editor must not reformat them.
[*.{json,yml,yaml,mjs,js}]
indent_size = 2

[*.md]
# Markdown line breaks are significant.
trim_trailing_whitespace = false

[LICENSE]
insert_final_newline = false
trim_trailing_whitespace = false
