node_modules/

# Build output of scripts/index-build-lite.mjs. Deliberately NOT committed: the
# artifact plane is regenerated from registry/ + ledger/ + ct/ on every CI run, and a
# committed copy could drift from its sources without anything failing.
/dist/
# The demo build (examples + fixture ledger/CT included). Never publishable.
/dist-demo/

# Scratch output of the verify scripts' --base-dir mode.
/.base-snapshot/
# Where CI checks out the public contract repository to byte-compare the two vendored
# files (schema/registry-v0-record.v1.json, config/category-funds.json) against their
# published originals. Nothing in it is ours.
/.vendor-check/
# Test workspaces. tests/helpers.mjs copies fixture trees here because the gates resolve
# --dir relative to the repository root, so a temp dir outside the repo would not work.
/.tmp-*/

.DS_Store
Thumbs.db

# CI checks out the PUBLIC purposesource/spec repository here so the schema gate can
# validate the emitted plane against the contracts as published, rather than against a
# vendored copy that could drift. It is never committed.
/spec/
